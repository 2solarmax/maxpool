<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mokka.rc-reconnect-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/maxpool/tools/rc-gate/rc-reconnect-watchdog.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/rc-reconnect-watchdog.out</string>
  <key>StandardErrorPath</key><string>/tmp/rc-reconnect-watchdog.err</string>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
